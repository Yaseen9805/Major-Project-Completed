{
  "title": "CostQual-Router",
  "uid": "costqual-router",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cache Hit Rate (%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(costqual_queries_total{cache_hit=\"True\"}) / sum(costqual_queries_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Estimated Cost",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(costqual_estimated_cost_total)", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Total Queries Handled",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(costqual_queries_total)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Queries by Tier",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(costqual_queries_total[5m])) by (tier_used)",
          "legendFormat": "{{tier_used}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "p95 Latency by Tier (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(costqual_query_latency_ms_bucket[5m])) by (le, tier_used))",
          "legendFormat": "{{tier_used}}",
          "refId": "A"
        }
      ]
    }
  ]
}
